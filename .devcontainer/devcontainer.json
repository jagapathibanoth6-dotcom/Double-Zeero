{
  "name": "Double Zero",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": {
    "site": "cat CODESPACE-LOGIN.txt 2>/dev/null; npm run dev"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Double Zero site", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["CODESPACE-LOGIN.txt"] },
    "vscode": { "extensions": ["Prisma.prisma", "dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"] }
  }
}
