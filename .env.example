# Local Double Zero platform
DATABASE_URL="file:./dev.db"
# Signs login cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=

# First owner account, created by `npm run db:seed` (password 10+ characters)
ADMIN_EMAIL="owner@doublezero.local"
ADMIN_PASSWORD="doublezero"

# Mail — Aspirants Way SMTP (admin@aspirantsway.com) until a Double Zero mailbox exists
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Double Zero
SMTP_FROM_EMAIL=
MAIL_PROVIDER=aspirants-way
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mail links replace localhost with the computer's Wi-Fi address so a phone can open them.

# ResDiary Consumer API — from developers.uk.hos.accessacloud.com → My Apps
RESDIARY_CLIENT_ID=
RESDIARY_CLIENT_SECRET=
RESDIARY_SUBSCRIPTION_KEY=
RESDIARY_AUDIENCE=https://api.hos.accessacloud.com
RESDIARY_SCOPE=consumer_api
RESDIARY_ENV=production

# Optional: override microsite names (Settings → Venue → Venue and Microsite Details)
RESDIARY_MICROSITE_MANCHESTER=DoubleZeroPizzeria
RESDIARY_MICROSITE_CHORLTON=DoubleZero

# Optional: embed widgets instead of / as well as the API form
NEXT_PUBLIC_RESDIARY_WIDGET_MANCHESTER=
NEXT_PUBLIC_RESDIARY_WIDGET_CHORLTON=
