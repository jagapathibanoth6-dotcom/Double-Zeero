# Double Zero — environment settings
# Copy this file to .env and fill in the values. Never commit .env.
# Settings marked (optional) can be left empty.

# ── Core ────────────────────────────────────────────────────────────────
# SQLite file for local development. "file:./dev.db" means prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Public address of the site, used in email links and Stripe redirects.
# Locally you can use your Mac's Wi-Fi address so a phone can open links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Signs login cookies. Required in production, 32+ characters.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=""

# First owner login, created by `npm run db:seed` (password 10+ characters).
# To add or reset staff later:  npm run staff:password -- <email> <password>
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Email (SMTP) ────────────────────────────────────────────────────────
# If SMTP_HOST/USER/PASS are empty, emails are skipped and logged instead.
SMTP_HOST=""
SMTP_PORT="587"          # 465 = SSL, 587 = STARTTLS
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Double Zero"
SMTP_FROM_EMAIL=""

# ── Payments ────────────────────────────────────────────────────────────
# Stripe API keys are entered per restaurant in Admin → Settings → Payments.
# The webhook secret comes from Stripe → Developers → Webhooks (endpoint: /api/pay/webhook).
STRIPE_WEBHOOK_SECRET=""

# ── ResDiary (optional) ─────────────────────────────────────────────────
# When these are set, normal-size table bookings are also sent to ResDiary.
# Keys from developers.uk.hos.accessacloud.com → My Apps.
RESDIARY_CLIENT_ID=""
RESDIARY_CLIENT_SECRET=""
RESDIARY_SUBSCRIPTION_KEY=""
RESDIARY_AUDIENCE=""
RESDIARY_SCOPE=""
RESDIARY_ENV=""                      # "sandbox" or empty for live
RESDIARY_CHANNEL=""                  # default ONLINE
RESDIARY_TOKEN_URL=""                # override only if ResDiary changes it
RESDIARY_API_BASE=""                 # override only if ResDiary changes it
RESDIARY_MICROSITE_MANCHESTER=""     # default from src/data/site.ts
RESDIARY_MICROSITE_CHORLTON=""
NEXT_PUBLIC_RESDIARY_WIDGET_MANCHESTER=""   # booking widget URL override
NEXT_PUBLIC_RESDIARY_WIDGET_CHORLTON=""
